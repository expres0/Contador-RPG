{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[a-f0-9]{20}$/)",
        ".write": "auth != null && $room.matches(/^[a-f0-9]{20}$/)",
        "state": {
          ".validate": "newData.hasChildren(['chars','order','round']) && newData.child('round').isNumber()"
        }
      }
    },
    "gmSecrets": {
      "$secret": {
        "$room": {
          ".read": "auth != null && $secret.matches(/^[a-f0-9]{32}$/) && $room.matches(/^[a-f0-9]{20}$/)",
          ".write": "auth != null && $secret.matches(/^[a-f0-9]{32}$/) && $room.matches(/^[a-f0-9]{20}$/)"
        }
      }
    }
  }
}
